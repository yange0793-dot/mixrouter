{
  "_说明": "路由规则模板。池成员写成字符串即用规则的目标模型,写成对象可各自指定模型与权重。",
  "rules": [
    {
      "_注释": "渠道池 + 会话粘性:同一个 Agent 的每个对话各锁一个渠道,对话内不切换",
      "id": "r1",
      "match": "opus, claude-3-opus",
      "provider": "",
      "model": "",
      "pool": [
        { "provider": "p1", "weight": 2 },
        { "provider": "p2", "model": "claude-opus-5[1M]" }
      ],
      "strategy": "weighted",
      "priority": 10,
      "when": {},
      "enabled": true
    },
    {
      "_注释": "单一渠道 + 附加条件(这里要求客户端 UA 含 claude-cli)",
      "id": "r2",
      "match": "sonnet",
      "provider": "p1",
      "model": "claude-sonnet-5",
      "pool": [],
      "strategy": "round_robin",
      "priority": 0,
      "when": { "ua": "claude-cli" },
      "enabled": true
    },
    {
      "_注释": "按对话分流:会话 id 含 vip 的走另一个渠道",
      "id": "r3",
      "match": "haiku",
      "provider": "p2",
      "model": "",
      "pool": [],
      "strategy": "round_robin",
      "priority": 0,
      "when": { "session": "vip" },
      "enabled": false
    }
  ],
  "default": { "provider": "", "model": "", "pool": [], "strategy": "round_robin" }
}
