# 含明文 key,永不入库;用 providers.example.json 作模板
providers.json
providers.json.tmp

# 本地路由规则(运行时状态);用 routes.example.json 作模板
routes.json
routes.json.tmp

# 会话绑定(运行时状态,含对话标签=对话内容片段,绝不入库)
sessions.json
sessions.json.tmp

# 子代理槽位(运行时状态;含渠道引用,无密钥但属本机状态)
slots.json
slots.json.tmp

# 客户端配置切换时留下的备份
*.bak-mixui-*

# 运行时产物
logs/
.run/

# 系统
.DS_Store
